<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================================
         CIR v1 BASELINE, part 2 of 2: the CIR domain schema.

         THIS IS THE VERSION 1 BASELINE. The database is dropped and recreated at the
         v1 cutover, so this runs only against an empty schema. The onFail="MARK_RAN"
         tableExists guard the previous revision carried is deliberately absent: it
         protected an additive create on an already-migrated database, and there is no
         longer any such database. Keeping it would leave a guard that cannot fire but
         that WOULD silently skip the create if the table were ever present for a
         reason nobody intended, turning a loud failure into a missing table.

         CIR is the only writer of cir_response (R-04). One row per arrival, committed
         BEFORE the response file is staged, so this table is the write-ahead filename
         ledger and system of record for every initial ACK/NACK.

         route_id IS part of identity (A-45, the cross-route twin lesson): the same
         (client, msg_id) arriving on onhost-req versus onhost-req-endo are distinct
         arrivals with distinct files, and an idempotency key narrower than the full
         business identity silently swallows one of them.

         reason closes A-48 (the headerless NACK reason was never persisted).
         accepted_count / total_count give the per-file acceptance ratio at a glance
         (spec 11.2 Tier-1). written_at still NULL after commit is the
         staged-but-not-written stuck signal.
         ============================================================================ -->

    <changeSet id="cir-v1-cir-response" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="cir_response"/></not>
        </preConditions>
        
        <createTable tableName="cir_response">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_cir_response_arrival"/>
            </column>
            <column name="client" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="msg_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="route_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(4)">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_cir_response_file"/>
            </column>
            <column name="reason" type="VARCHAR(64)"/>
            <column name="accepted_count" type="INT"/>
            <column name="total_count" type="INT"/>
            <column name="written_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="cir_response"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
